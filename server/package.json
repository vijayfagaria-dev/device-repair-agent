{
  "name": "@device-repair/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "smoke": "node test/smoke/deployed-smoke.ts",
    "eval": "node --env-file-if-exists=.env dist/eval/run.js",
    "report": "node scripts/report.ts"
  },
  "dependencies": {
    "@device-repair/shared": "*",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.7",
    "ajv": "8.20.0",
    "fastify": "5.12.8",
    "openai": "7.45.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "ws": "8.22.1"
  }
}
